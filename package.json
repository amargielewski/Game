{
  "name": "feast-knight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=16.16.0",
    "npm": ">=8.11.0"
  },
  "scripts": {
    "start": "vite --open",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts && npm run lint:comments",
    "lint:comments": "! grep -rnE '^[[:space:]]*(//|/\\*)' src --include=*.ts",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "pixi.js": "^7.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vite": "^4.5.3",
    "vitest": "^0.34.6"
  }
}
